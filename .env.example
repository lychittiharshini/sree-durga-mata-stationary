# Application Configuration
PORT=3000
NODE_ENV=development

# Shop WhatsApp Configuration (Can also be updated via Admin Panel)
DEFAULT_WHATSAPP_NUMBER=919876543210

# Admin Credentials (Private configuration — set your secret credentials in .env, never commit passwords to GitHub)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_private_secure_password_here
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# PostgreSQL Database Configuration (Optional for local dev, auto-detected if provided)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sree_durga_stationery
# Or discrete parameters:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=sree_durga_stationery
# PGUSER=postgres
# PGPASSWORD=password
